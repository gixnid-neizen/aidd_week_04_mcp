{
  "$version": 4,
  "modelProviders": {
    "openai": [
      {
        "id": "agentic/gc_v3",
        "name": "agentic/gc_v3",
        "baseUrl": "https://llmhub.sberai-rnd.ru/v1",
        "envKey": "MODEL_API_KEY",
        "generationConfig": {
          "samplingParams": {
            "temperature": 0.8,
            "top_p": 0.95,
            "max_tokens": 65536
          }
        }
      }
    ]
  },
  "security": {
    "auth": {
      "selectedType": "openai"
    }
  },
  "model": {
    "name": "agentic/gc_v3",
    "baseUrl": "https://llmhub.sberai-rnd.ru/v1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^run_shell_command$",
        "hooks": [
          {
            "type": "command",
            "command": "/home/default/projects/ai/aidd_week_04_mcp/.venv/bin/python \"$QWEN_PROJECT_DIR/.qwen/hooks/guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "context": {
    "fileName": ["QWEN.md"]
  },
  "memory": {
    "enableManagedAutoMemory": false,
    "enableManagedAutoDream": false
  },
    "mcpServers": {
    "todo": {
      "command": "/home/default/projects/ai/aidd_week_04_mcp/.venv/bin/python",
      "args": ["/home/default/projects/ai/aidd_week_04_mcp/practice/mcp/server.py"],
      "env": { "TODO_API_URL": "http://127.0.0.1:5000" }
    },
    "excel": {
      "command": "/home/default/projects/ai/aidd_week_04_mcp/.venv/bin/excel-mcp-server",
      "args": [
        "stdio",
        "--allow-dir",
        "/home/default/projects/ai/aidd_week_04_mcp/practice/agent"
      ]
    }
  }
}