      {
        "parameters": {
          "jsCode": "const input = $input.first().json;\nconst message = String(input.body?.message ?? input.message ?? '').trim();\nif (!message) throw new Error('Provide a message in body.message');\nconst urgent = /\\b(urgent|critical|outage|срочно|авария|не работает)\\b/i.test(message);\nconst category = /\\b(payment|invoice|billing|оплат|сч[её]т)\\b/i.test(message) ? 'billing'\n  : /\\b(login|password|account|аккаунт|парол)\\b/i.test(message) ? 'account'\n  : /\\b(error|bug|broken|ошиб|не работает)\\b/i.test(message) ? 'technical'\n  : 'other';\nreturn [{ json: { title: message.slice(0, 200), category, urgent, priority: urgent ? 'high' : 'normal' } }];"
        },
